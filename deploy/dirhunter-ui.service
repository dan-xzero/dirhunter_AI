[Unit]
Description=DirHunter Portal UI
After=network-online.target dirhunter-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dirhunter_AI/frontend
EnvironmentFile=/etc/dirhunter/dirhunter.env
Environment=PORT=3000
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
