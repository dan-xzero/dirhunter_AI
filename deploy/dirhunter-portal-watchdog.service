[Unit]
Description=DirHunter Portal Auto-Heal Watchdog
After=network-online.target postgresql.service redis-server.service nginx.service dirhunter-api.service dirhunter-ui.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/dirhunter_AI
EnvironmentFile=/etc/dirhunter/dirhunter.env
Environment=PATH=/root/go/bin:/opt/dirhunter_AI/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/dirhunter_AI/dirscan/bin/python scripts/portal_watchdog.py --once
User=root
